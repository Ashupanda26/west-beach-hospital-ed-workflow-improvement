<mxfile host="app.diagrams.net" modified="2026-11-05T12:00:00.000Z" agent="OpenAI" version="24.7.17" type="device"><diagram id="future-state-ed" name="Future-State Process Map"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="WEST BEACH HOSPITAL | EMERGENCY DEPARTMENT&lt;br&gt;&lt;b&gt;Future-State Patient Check-In and Administrative Handover&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1500" height="50" as="geometry" /></mxCell><mxCell id="subtitle" value="Proposed administrative workflow | Scenario-based portfolio design | Clinical assessment and triage remain under clinical-team ownership" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1650" height="28" as="geometry" /></mxCell><mxCell id="lane_patient" value="PATIENT" style="swimlane;horizontal=0;startSize=34;rounded=0;html=1;whiteSpace=wrap;fillColor=#F8FAFC;swimlaneFillColor=#E2E8F0;strokeColor=#94A3B8;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="2050" height="190" as="geometry" /></mxCell><mxCell id="lane_admin" value="RECEPTION / ADMINISTRATIVE TEAM" style="swimlane;horizontal=0;startSize=34;rounded=0;html=1;whiteSpace=wrap;fillColor=#F8FAFC;swimlaneFillColor=#E2E8F0;strokeColor=#94A3B8;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="315" width="2050" height="565" as="geometry" /></mxCell><mxCell id="lane_clinical" value="CLINICAL TEAM" style="swimlane;horizontal=0;startSize=34;rounded=0;html=1;whiteSpace=wrap;fillColor=#F8FAFC;swimlaneFillColor=#E2E8F0;strokeColor=#94A3B8;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="2050" height="230" as="geometry" /></mxCell><mxCell id="p_start" value="Patient arrives" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4F9A63;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="115" y="185" width="115" height="55" as="geometry" /></mxCell><mxCell id="p_info" value="Provides required information&lt;br&gt;and receives clear check-in guidance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4F81BD;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="330" y="175" width="190" height="75" as="geometry" /></mxCell><mxCell id="p_next" value="Receives explanation of next steps&lt;br&gt;and any outstanding admin action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4F9A63;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1600" y="175" width="230" height="75" as="geometry" /></mxCell><mxCell id="a_ack" value="Acknowledge arrival&lt;br&gt;and record arrival milestone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4F81BD;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="385" width="175" height="75" as="geometry" /></mxCell><mxCell id="a_urgent" value="Immediate concern raised&lt;br&gt;or observed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="370" width="145" height="105" as="geometry" /></mxCell><mxCell id="a_alert" value="Use approved urgent escalation route;&lt;br&gt;alert clinical team immediately.&lt;br&gt;Do not delay for registration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#C58A26;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="510" y="335" width="205" height="105" as="geometry" /></mxCell><mxCell id="a_existing" value="Check available information&lt;br&gt;through authorised sources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4F81BD;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="510" y="535" width="195" height="75" as="geometry" /></mxCell><mxCell id="a_collect" value="Collect only the minimum&lt;br&gt;required administrative information" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4F81BD;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="755" y="535" width="205" height="75" as="geometry" /></mxCell><mxCell id="a_complete" value="Required information&lt;br&gt;complete?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1005" y="515" width="145" height="115" as="geometry" /></mxCell><mxCell id="a_missing" value="Record missing information;&lt;br&gt;assign an administrative owner&lt;br&gt;and follow-up action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#C58A26;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1210" y="650" width="215" height="95" as="geometry" /></mxCell><mxCell id="a_register" value="Complete registration steps&lt;br&gt;and record status / milestone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4F9A63;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1210" y="510" width="215" height="85" as="geometry" /></mxCell><mxCell id="a_handover" value="Prepare structured handover:&lt;br&gt;minimum necessary admin information&lt;br&gt;and outstanding actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4F81BD;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1470" y="510" width="230" height="90" as="geometry" /></mxCell><mxCell id="a_send" value="Communicate through the&lt;br&gt;approved secure channel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4F81BD;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1745" y="510" width="175" height="85" as="geometry" /></mxCell><mxCell id="a_ackdecision" value="Receipt acknowledged?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1940" y="495" width="130" height="115" as="geometry" /></mxCell><mxCell id="a_follow" value="Follow agreed contact /&lt;br&gt;escalation procedure; retain&lt;br&gt;administrative ownership until resolved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#C58A26;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1755" y="700" width="260" height="100" as="geometry" /></mxCell><mxCell id="c_urgent" value="Clinical team responds under&lt;br&gt;local urgent escalation procedure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#C58A26;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="770" y="915" width="230" height="85" as="geometry" /></mxCell><mxCell id="c_receive" value="Receive and acknowledge&lt;br&gt;administrative handover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4F9A63;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1745" y="950" width="190" height="75" as="geometry" /></mxCell><mxCell id="c_end" value="Administrative handover complete&lt;br&gt;&lt;b&gt;Boundary: initial clinical assessment&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4F9A63;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1970" y="945" width="175" height="85" as="geometry" /></mxCell><mxCell id="safety_note" value="SAFETY CONTROL&lt;br&gt;Reception staff do not assess clinical urgency, apply triage criteria or prioritise patients. Any urgent concern is escalated immediately under local procedures. Registration must not delay clinical attention." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FCE8E6;strokeColor=#C76B65;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="750" y="740" width="500" height="105" as="geometry" /></mxCell><mxCell id="guard_note" value="INFORMATION CONTROL&lt;br&gt;Use only approved sources and channels. Share the minimum necessary information with authorised recipients. Follow local downtime and confidentiality procedures." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FCE8E6;strokeColor=#C76B65;fontSize=12;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1300" y="785" width="490" height="80" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4B5563;" edge="1" parent="1" source="p_start" target="a_ack"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4B5563;" edge="1" parent="1" source="a_ack" target="a_urgent"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C76B65;" edge="1" parent="1" source="a_urgent" target="a_alert"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="Immediate escalation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C76B65;" edge="1" parent="1" source="a_alert" target="c_urgent"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4B5563;" edge="1" parent="1" source="a_urgent" target="a_existing"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4B5563;" edge="1" parent="1" source="a_existing" target="a_collect"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4B5563;" edge="1" parent="1" source="a_collect" target="a_complete"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4B5563;" edge="1" parent="1" source="a_complete" target="a_register"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4B5563;" edge="1" parent="1" source="a_complete" target="a_missing"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="Outstanding action remains assigned" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4B5563;" edge="1" parent="1" source="a_missing" target="a_handover"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4B5563;" edge="1" parent="1" source="a_register" target="a_handover"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4B5563;" edge="1" parent="1" source="a_handover" target="a_send"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4B5563;" edge="1" parent="1" source="a_send" target="a_ackdecision"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4B5563;" edge="1" parent="1" source="a_ackdecision" target="c_receive"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C58A26;" edge="1" parent="1" source="a_ackdecision" target="a_follow"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="Retry / escalate per procedure" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C58A26;" edge="1" parent="1" source="a_follow" target="a_send"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4B5563;" edge="1" parent="1" source="c_receive" target="c_end"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="Clinical pathway continues" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C76B65;" edge="1" parent="1" source="c_urgent" target="c_end"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="Information provided" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1;dashed=1;strokeColor=#64748B;" edge="1" parent="1" source="p_info" target="a_collect"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" value="Next-step communication" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1;dashed=1;strokeColor=#64748B;" edge="1" parent="1" source="a_send" target="p_next"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="footer" value="Proposed process design derived from the portfolio scenario. Validate all steps, approved channels, role ownership and escalation routes with the hospital before operational use." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="1900" height="35" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>